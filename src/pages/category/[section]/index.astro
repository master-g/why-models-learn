---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSections } from '../../../lib/sections.mjs';
import { withBase } from '../../../lib/base.mjs';
import { getEntries } from '../../_entries.mjs';

export async function getStaticPaths() {
  return getSections().map((section) => ({
    params: { section: section.dir },
    props: { section },
  }));
}

const { section } = Astro.props;
const entries = await getEntries();
const bySlug = new Map(
  entries.map((e) => {
    const [sec, slug] = e.id.split('/');
    return [slug, { entry: e, section: sec }];
  }),
);

const title = `${section.name_zh} | 模型为什么会学习`;
---

<BaseLayout title={title}>
  <div class="post-header">
    <nav class="post-header-breadcrumb" aria-label="Breadcrumb">分类</nav>
    <div class="post-header-section-title">
      <h1 class="post-header-title">{section.name_zh}</h1>
      <div class="post-header-meta">{section.entries.length} 个条目</div>
      {
        section.description_zh && (
          <div class="post-header-cat-description" lang="zh-CN">
            <p>{section.description_zh}</p>
          </div>
        )
      }
    </div>
  </div>

  <div class="page-search-wrapper">
    {
      section.entries.map((slug) => {
        const found = bySlug.get(slug);
        return (
          <div class="search-results__item">
            <div class="search-results__title">
              {found ? (
                <a href={withBase(`/${slug}/`)}>{found.entry.data.title}</a>
              ) : (
                <span class="entry-todo">{slug} <span class="badge-untranslated">TODO</span></span>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</BaseLayout>
