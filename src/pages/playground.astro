---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 渲染试验田:用与词条完全相同的管线和版式渲染 playground/ 下的 fixture。
// 不进首页与搜索;URL 直达 /playground/。
const docs = await getCollection('playground');
docs.sort((a, b) => a.id.localeCompare(b.id));
const rendered = await Promise.all(
  docs.map(async (doc) => ({ doc, Content: (await render(doc)).Content })),
);
---

<BaseLayout title="渲染试验田 | 模型为什么会学习">
  {
    rendered.map(({ doc, Content }) => (
      <article class="post" lang="zh-CN">
        <div class="post-header">
          <nav class="post-header-breadcrumb" aria-label="Breadcrumb">
            <span>playground</span>
          </nav>
          <div class="post-header-section-title">
            <h1 class="post-header-title">{doc.data.title}</h1>
          </div>
        </div>
        <div class="post-content">
          <Content />
        </div>
      </article>
    ))
  }
</BaseLayout>
