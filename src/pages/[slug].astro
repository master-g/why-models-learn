---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getSection } from '../lib/sections.mjs';
import { getNextAvailableSlug } from '../lib/article-navigation.mjs';
import { withBase } from '../lib/base.mjs';
import { getEntries } from './_entries.mjs';

export async function getStaticPaths() {
  const entries = await getEntries();
  const availableSlugs = new Set(entries.map((entry) => entry.id.split('/')[1]));
  return entries.map((entry) => {
    const [section, slug] = entry.id.split('/');
    const sectionMeta = getSection(section);
    const nextSlug = getNextAvailableSlug(sectionMeta?.entries || [], slug, availableSlugs);
    return {
      params: { slug },
      props: { entry, section, nextSlug },
    };
  });
}

const { entry, section, nextSlug } = Astro.props;
const { Content } = await render(entry);
const sectionMeta = getSection(section);
const articleIndex = sectionMeta?.entries.indexOf(entry.id.split('/')[1]) ?? -1;
const articleNumber = articleIndex >= 0 ? articleIndex + 1 : 1;
const pageTitle = `${entry.data.title} | 模型为什么会学习`;
---

<BaseLayout title={pageTitle}>
  <article class="article-page" lang="zh-CN">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href={withBase('/')}>全库目录</a><span>/</span>
      <a href={withBase(`/category/${section}/`)}>{sectionMeta?.name_zh || section}</a><span>/</span>
      <span>{entry.data.title}</span>
    </nav>

    <header class="article-header">
      <div>
        <span class="page-kicker">第 {sectionMeta?.order || '—'} 章 · 第 {articleNumber} 篇</span>
        <h1 class="article-title">{entry.data.title}</h1>
      </div>
      <aside class="article-meta">
        <strong>词条资料</strong>
        <span>语言：简体中文</span>
        <span>状态：已完成</span>
        <span>主题：{entry.data.tags?.length || 0}</span>
      </aside>
    </header>

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-attribution">
      <p>本文正文与原创插图按 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 提供。</p>
      <p>软件代码采用 MIT License；软件代码与第三方材料不在此许可范围内。完整边界见仓库的 <a href="https://github.com/master-g/why-models-learn/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer">许可范围</a>。</p>
    </footer>

    <nav class="chapter-nav" aria-label="章节导航">
      <a href={withBase(`/category/${section}/`)}>← 返回本章目录</a>
      {nextSlug ? <a href={withBase(`/${nextSlug}/`)}>下一篇 →</a> : <span>本章结束</span>}
    </nav>
  </article>
</BaseLayout>
