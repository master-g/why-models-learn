---
export interface Props {
  variant: 'desktop' | 'mobile';
}

const { variant } = Astro.props;
const inputClass = variant === 'desktop' ? 'search-input -desktop' : 'search-input';
const iconClass = variant === 'desktop' ? 'search__icon -desktop' : 'search__icon';
---

<div class="search__container" data-search-role="container">
  <form action="/search/" data-search-role="form">
    <input
      name="s"
      class={inputClass}
      type="text"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="搜索…"
      data-search-role="input"
    />
    <button class={iconClass} type="submit" aria-label="搜索">
      <img alt="" src="/theme/images/icon-search.svg" width="22" height="22" />
    </button>
  </form>
  <div class="search__suggestions" data-search-role="suggestions">
    <ul data-search-role="list"></ul>
  </div>
</div>

<script>
  import { scoreEntry } from '../lib/search-score.mjs';

  const EMPTY_TEXT = '无结果';
  const LOADING_TEXT = '加载中…';
  const ERROR_TEXT = '搜索不可用';
  const UNTRANSLATED_TEXT = '未翻译';
  const MAX_SUGGESTIONS = 5;
  const SEARCH_URL = '/search.json';

  function initSearch(container) {
    const form = container.querySelector('[data-search-role="form"]');
    const input = container.querySelector('[data-search-role="input"]');
    const wrap = container.querySelector('[data-search-role="suggestions"]');
    const list = container.querySelector('[data-search-role="list"]');

    let index = [];
    let status = 'idle'; // idle | loading | ready | error
    let highlighted = -1;
    let query = '';

    function setOpen(open) {
      container.classList.toggle('js-is-search-active', open);
      container.classList.toggle('js-is-suggestion-active', open);
    }

    function close() {
      setOpen(false);
      highlighted = -1;
    }

    function showMessage(text) {
      list.textContent = '';
      const li = document.createElement('li');
      const span = document.createElement('span');
      span.className = 'search-suggestion-message';
      span.textContent = text;
      li.appendChild(span);
      list.appendChild(li);
      setOpen(true);
    }

    function loadIndex() {
      if (status !== 'idle') return;
      status = 'loading';
      showMessage(LOADING_TEXT);

      fetch(SEARCH_URL)
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          index = Array.isArray(data) ? data : [];
          status = 'ready';
          updateSuggestions(input.value);
        })
        .catch(() => {
          status = 'error';
          showMessage(ERROR_TEXT);
        });
    }

    function rank(queryText) {
      const q = queryText.trim();
      if (!q) return [];
      return index
        .map((entry) => ({ entry, score: scoreEntry(entry, q) }))
        .filter((item) => item.score > 0)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          const aLen = String(a.entry.title_en).length;
          const bLen = String(b.entry.title_en).length;
          if (aLen !== bLen) return aLen - bLen;
          return String(a.entry.title_en).localeCompare(String(b.entry.title_en));
        })
        .slice(0, MAX_SUGGESTIONS)
        .map((item) => item.entry);
    }

    function renderSuggestions(results) {
      list.textContent = '';
      highlighted = -1;

      if (results.length === 0) {
        showMessage(EMPTY_TEXT);
        return;
      }

      for (let i = 0; i < results.length; i++) {
        const entry = results[i];
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = entry.url;
        a.dataset.index = String(i);

        const title = document.createElement('span');
        title.className = 'search-suggestion-title';
        title.textContent = entry.title_zh || entry.title_en;
        a.appendChild(title);

        if (!entry.title_zh) {
          const marker = document.createElement('span');
          marker.className = 'search-untranslated';
          marker.textContent = UNTRANSLATED_TEXT;
          a.appendChild(marker);
        }

        a.addEventListener('click', () => {
          close();
        });

        li.appendChild(a);
        list.appendChild(li);
      }

      setOpen(true);
    }

    function updateSuggestions(value) {
      query = value;
      if (status === 'error') {
        showMessage(ERROR_TEXT);
        return;
      }
      if (status === 'loading') {
        showMessage(LOADING_TEXT);
        return;
      }
      if (status === 'idle') {
        loadIndex();
        return;
      }
      renderSuggestions(rank(query));
    }

    function moveHighlight(delta) {
      const items = list.querySelectorAll('li');
      if (items.length === 0) return;
      highlighted = (highlighted + delta + items.length) % items.length;
      items.forEach((item, i) => {
        item.classList.toggle('search-suggestion-highlight', i === highlighted);
      });
    }

    function openHighlighted() {
      const links = list.querySelectorAll('li a');
      const target = links[highlighted] || links[0];
      if (target) {
        window.location.href = target.href;
      }
    }

    input.addEventListener('focus', () => {
      if (status === 'idle') loadIndex();
      else if (query) updateSuggestions(query);
    });

    input.addEventListener('input', () => {
      updateSuggestions(input.value);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        moveHighlight(1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        moveHighlight(-1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        openHighlighted();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        close();
        input.focus();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      openHighlighted();
    });

    document.addEventListener('click', (event) => {
      if (!container.contains(event.target)) {
        close();
      }
    });
  }

  document.querySelectorAll('[data-search-role="container"]').forEach(initSearch);
</script>

<style is:global>
  .search-suggestion-message {
    display: block;
    padding: 0 12px;
    color: #636363;
  }
  .search-untranslated {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 5px;
    border-radius: 3px;
    background: #e9e3e2;
    color: #636363;
    font-size: 11px;
    line-height: 1.4;
  }
  .search__suggestions li.search-suggestion-highlight,
  .search__suggestions li.search-suggestion-highlight a {
    background: #d7cdcb;
  }
</style>
