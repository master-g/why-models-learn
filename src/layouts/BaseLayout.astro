---
import SearchBox from '../components/SearchBox.astro';
import '../styles/site.css';
import { withBase } from '../lib/base.mjs';

export interface Props {
  lang?: string;
  title?: string;
}
const { lang = 'zh-CN', title = '模型为什么会学习' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} data-theme="white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('why-models-learn-theme');
          if (saved === 'black') document.documentElement.dataset.theme = 'black';
        } catch (_) {
          // 本地文件预览可能禁用 storage。
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={withBase('/')} aria-label="模型为什么会学习首页">
          <span class="site-brand__name">模型为什么会学习</span>
          <span class="site-brand__tagline">结构化机器学习条目</span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a href={withBase('/learn/')}>学习路径</a>
          <a href={withBase('/')}>章节目录</a>
          <a href={withBase('/glossary/')}>词汇表</a>
          <a href={withBase('/about/')}>关于</a>
          <a href="https://github.com/master-g/why-models-learn" target="_blank" rel="noopener noreferrer">GitHub</a>
          <SearchBox variant="desktop" />
          <div class="theme-switch" role="group" aria-label="黑白主题">
            <button type="button" data-theme-choice="white" aria-pressed="true" title="白色主题">白</button>
            <button type="button" data-theme-choice="black" aria-pressed="false" title="黑色主题">黑</button>
          </div>
        </nav>

        <details class="site-menu">
          <summary aria-label="展开导航"><span></span><span></span><span></span></summary>
          <div class="site-menu__panel">
            <SearchBox variant="mobile" />
            <a href={withBase('/learn/')}>学习路径</a>
            <a href={withBase('/')}>章节目录</a>
            <a href={withBase('/glossary/')}>词汇表</a>
            <a href={withBase('/about/')}>关于</a>
            <a href="https://github.com/master-g/why-models-learn" target="_blank" rel="noopener noreferrer">GitHub</a>
            <div class="theme-switch" role="group" aria-label="黑白主题">
              <button type="button" data-theme-choice="white" aria-pressed="true">白色</button>
              <button type="button" data-theme-choice="black" aria-pressed="false">黑色</button>
            </div>
          </div>
        </details>
      </div>
    </header>

    <main id="main-content" class="site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <span>模型为什么会学习 · 独立界面与中文排版</span>
      <span>正文与原创插图采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></span>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-theme-choice]'));

        function setTheme(theme, persist = true) {
          const next = theme === 'black' ? 'black' : 'white';
          root.dataset.theme = next;
          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === next));
          });
          if (persist) {
            try { localStorage.setItem('why-models-learn-theme', next); } catch (_) {}
          }
        }

        setTheme(root.dataset.theme, false);
        buttons.forEach((button) => {
          button.addEventListener('click', () => setTheme(button.dataset.themeChoice));
        });
      })();
    </script>
  </body>
</html>
