---
import SearchBox from '../components/SearchBox.astro';

export interface Props {
  lang?: string;
  title?: string;
}
const { lang = 'zh-CN', title = '模型为什么会学习' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/theme/style.css" />
    <link rel="stylesheet" href="/styles/zh-overrides.css" />
  </head>
  <body>
    <div id="curtain" class="curtain"></div>

    <header id="header" class="header">
      <div class="header-main-layout">
        <div class="header-main-layout__layer--left only-mobile">
          <details class="mobile-nav">
            <summary class="menu-float__hamburger" aria-label="展开导航">
              <div></div>
              <div></div>
              <div></div>
            </summary>
            <div class="mobile-nav__panel">
              <div class="sidebar__brand">
                <a href="/" aria-label="模型为什么会学习首页">
                  <img src="/theme/images/icon-algebrica.svg" alt="" width="40" height="40" />
                </a>
              </div>
              <div class="sidebar__section">
                <div class="search__wrapper">
                  <div id="search-mobile">
                    <SearchBox variant="mobile" />
                  </div>
                </div>
              </div>
              <div class="sidebar__section">
                <div class="sidebar__menu">
                  <div class="sidebar-list">
                    <div class="sidebar-nav-li"><a href="/">首页 / 索引</a></div>
                    <div class="sidebar-nav-li"><a href="/about/">关于</a></div>
                    <div class="sidebar-nav-li"><a href="https://github.com/master-g/why-models-learn" target="_blank" rel="noopener noreferrer">GitHub 仓库</a></div>
                  </div>
                </div>
              </div>
              <div class="sidebar__bottom-links">
                <div class="sidebar__license">
                  内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可。
                </div>
              </div>
            </div>
          </details>
        </div>
        <div class="header-main-layout__layer--center">
          <div class="only-mobile">
            <a href="/" aria-label="模型为什么会学习首页">
              <img src="/theme/images/icon-algebrica.svg" alt="" width="42" height="21" />
            </a>
          </div>
        </div>
        <div class="header-main-layout__layer--right"></div>
      </div>
    </header>

    <div id="site-main" class="main">
      <div id="site-container" class="container relative">
        <div id="site-container-grid" class="site-container">
          <aside id="site-sidebar-right" class="sidebar site-column no-mobile" aria-label="站点导航">
            <div class="sidebar__brand">
              <a href="/" aria-label="模型为什么会学习首页">
                <img src="/theme/images/icon-algebrica.svg" alt="" width="40" height="40" />
              </a>
            </div>
            <div class="sidebar__section">
              <div class="search__wrapper">
                <div id="search-desktop">
                  <SearchBox variant="desktop" />
                </div>
              </div>
            </div>
            <div class="sidebar__section">
              <div class="sidebar__menu">
                <div class="sidebar-list">
                  <div class="sidebar-nav-li"><a href="/">首页 / 索引</a></div>
                  <div class="sidebar-nav-li"><a href="/about/">关于</a></div>
                  <div class="sidebar-nav-li"><a href="https://github.com/master-g/why-models-learn" target="_blank" rel="noopener noreferrer">GitHub 仓库</a></div>
                </div>
              </div>
            </div>
            <div class="sidebar__bottom-links">
              <div class="sidebar__license">
                内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可。
              </div>
            </div>
          </aside>

          <div id="site-content" class="site-column-main">
            <slot />
          </div>
        </div>
      </div>
    </div>

    <div class="footer"></div>

  </body>
</html>
